# ─────────────────────────────────────────────────────────────
# Outfits — variáveis de ambiente
# Copia para .env.local e preenche os valores
# ─────────────────────────────────────────────────────────────

# === Base de dados (Neon Postgres) ===
# Painel Neon → Connection string (pooled)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# === Auth.js ===
# Gerar com:  pnpm dlx auth secret
AUTH_SECRET=""
# Em produção mete o domínio real
AUTH_URL="http://localhost:3000"

# === Google OAuth (login) ===
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# === Resend (login por magic link) ===
# Resend → API Keys
RESEND_API_KEY=""
# Domínio verificado em Resend → Domains. Sem isto, o remetente cai no
# onboarding@resend.dev partilhado, que SÓ entrega ao dono da conta Resend —
# ou seja, mais ninguém consegue entrar por email.
RESEND_EMAIL_DOMAIN=""
# Opcional: endereço completo do remetente. Se ficar vazio, deriva-se
# no-reply@$RESEND_EMAIL_DOMAIN
AUTH_EMAIL_FROM=""

# === Gemini (Google Generative AI) — o cérebro da IA ===
# A tua chave da API do Gemini (Google AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=""

# === Vercel Blob (armazenamento das imagens recortadas) ===
# Vercel → Storage → Blob → Token de leitura/escrita
BLOB_READ_WRITE_TOKEN=""
